{
  "name": "core-robin-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "i18n:status": "i18next-cli status",
    "i18n:extract": "i18next-cli extract",
    "i18n:types": "i18next-cli types",
    "i18n:check": "i18next-cli status && i18next-cli types --ci && NODE_OPTIONS=--no-experimental-webstorage vitest run src/i18n.test.ts src/desktopNotifications.test.ts src/robinCompanion.test.tsx",
    "test:surface-contracts": "NODE_OPTIONS=--no-experimental-webstorage vitest run scripts/surface-contracts.test.mjs src/healthStatePublisher.test.ts src/hooks/healthStateSync.test.tsx src/trayPanel.test.tsx src/robinCompanion.test.tsx",
    "test:performance-contracts": "NODE_OPTIONS=--no-experimental-webstorage vitest run src/hooks/monitorVisibility.test.tsx src/cleanupCanvasPatterns.test.ts",
    "verify:web-bundle": "node scripts/verify-web-bundle.mjs",
    "verify:release-tools": "node scripts/record-release-device-smoke.mjs --dry-run && node scripts/capture-monitor-baseline.mjs --dry-run && bash -n scripts/verify-packaged-macos.sh scripts/verify-packaged-linux.sh",
    "release:gate:static": "pnpm build && pnpm verify:web-bundle && pnpm test:surface-contracts && pnpm test:performance-contracts",
    "release:smoke:device": "node scripts/record-release-device-smoke.mjs",
    "performance:baseline": "node scripts/capture-monitor-baseline.mjs",
    "public:sync": "node scripts/sync-public-content.mjs",
    "release:notes": "node scripts/render-release-notes.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "i18next-cli": "^1.65.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
