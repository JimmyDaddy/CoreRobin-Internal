{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreRobin",
  "version": "0.1.29",
  "identifier": "com.corerobin.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CoreRobin",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "CoreRobin",
        "url": "splash.html",
        "width": 520,
        "height": 340,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "tray",
        "title": "CoreRobin Status",
        "url": "tray.html",
        "width": 360,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "companion",
        "title": "Robin",
        "url": "companion.html",
        "width": 92,
        "height": 92,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1421 https://monitor-app.corerobin.com; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "hardenedRuntime": true
    },
    "resources": {
      "infoplist/**/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDODIwOERGQ0VFQjA0N0EKUldSNkJPdk8zd2lDN1A3Z2tmdWFjY0NQQXRSWlB4V0RsZ0lSOUFCdEpyenc2SzlMRzFrUEc5NUwK",
      "endpoints": [
        "https://github.com/JimmyDaddy/corerobin-monitor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
