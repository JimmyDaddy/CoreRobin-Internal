{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Full CoreRobin application capability for the trusted main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "process:allow-restart",
    "updater:default",
    "dialog:allow-open",
    "allow-get-system-snapshot",
    "allow-get-system-summary",
    "allow-publish-health-state",
    "allow-get-health-state",
    "allow-get-network-connections",
    "allow-run-network-quality-check",
    "allow-resolve-network-hosts",
    "allow-get-startup-context",
    "allow-get-gpu-energy-snapshot",
    "allow-scan-file-insights",
    "allow-cancel-file-insights-scan",
    "allow-load-persisted-file-insights-scan",
    "allow-save-persisted-file-insights-scan",
    "allow-clear-persisted-file-insights-scan",
    "allow-revalidate-file-insights-scan",
    "allow-get-startup-items",
    "allow-create-startup-management-lease",
    "allow-release-startup-management-lease",
    "allow-execute-startup-management",
    "allow-get-cleanup-scan",
    "allow-get-cleanup-path-state",
    "allow-get-cleanup-subtree",
    "allow-load-persisted-cleanup-scan",
    "allow-save-persisted-cleanup-scan",
    "allow-clear-persisted-cleanup-scan",
    "allow-load-persisted-application-history",
    "allow-save-persisted-application-history",
    "allow-clear-persisted-application-history",
    "allow-get-product-data-cache-summary",
    "allow-clear-application-inventory-cache",
    "allow-clear-persisted-product-data",
    "allow-cancel-cleanup-scan",
    "allow-cancel-cleanup-subtree",
    "allow-get-cleanup-scan-access",
    "allow-open-cleanup-full-disk-access-settings",
    "allow-reveal-cleanup-app-bundle",
    "allow-reveal-path",
    "allow-preview-path",
    "allow-resolve-user-path",
    "allow-eject-removable-volume",
    "allow-get-storage-health",
    "allow-open-disk-utility",
    "allow-open-system-settings",
    "allow-open-product-page",
    "allow-open-product-issue",
    "allow-relaunch-application",
    "allow-can-relaunch-application",
    "allow-get-installed-applications",
    "allow-get-application-uninstall-plan",
    "allow-execute-native-application-uninstall",
    "allow-create-cleanup-delete-lease",
    "allow-release-cleanup-delete-lease",
    "allow-set-cleanup-delete-lease-mode",
    "allow-execute-cleanup-delete",
    "allow-cancel-cleanup-delete",
    "allow-complete-startup",
    "allow-show-main-window",
    "allow-quit-application",
    "allow-set-dock-icon-visible",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-toggle-companion-window",
    "allow-hide-companion-window",
    "allow-set-companion-expanded",
    "allow-configure-companion-window",
    "allow-get-process-detail",
    "allow-get-application-icon",
    "allow-create-process-control-lease",
    "allow-release-process-control-lease",
    "allow-execute-process-action"
  ]
}
