{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Full StatusOrbit application capability for the trusted main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-get-system-snapshot",
    "allow-get-network-connections",
    "allow-get-startup-items",
    "allow-create-startup-management-lease",
    "allow-release-startup-management-lease",
    "allow-execute-startup-management",
    "allow-get-cleanup-scan",
    "allow-get-cleanup-path-state",
    "allow-get-cleanup-subtree",
    "allow-load-persisted-cleanup-scan",
    "allow-save-persisted-cleanup-scan",
    "allow-clear-persisted-cleanup-scan",
    "allow-cancel-cleanup-scan",
    "allow-cancel-cleanup-subtree",
    "allow-get-cleanup-scan-access",
    "allow-open-cleanup-full-disk-access-settings",
    "allow-reveal-cleanup-app-bundle",
    "allow-create-cleanup-delete-lease",
    "allow-release-cleanup-delete-lease",
    "allow-execute-cleanup-delete",
    "allow-cancel-cleanup-delete",
    "allow-complete-startup",
    "allow-show-main-window",
    "allow-toggle-companion-window",
    "allow-hide-companion-window",
    "allow-set-companion-expanded",
    "allow-configure-companion-window",
    "allow-get-process-detail",
    "allow-get-application-icon",
    "allow-create-process-control-lease",
    "allow-release-process-control-lease",
    "allow-execute-process-action"
  ]
}
