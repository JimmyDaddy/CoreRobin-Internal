{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "Narrow event, window and application controls for the Robin companion",
  "windows": ["companion"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-size",
    "core:window:allow-is-visible",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "allow-get-health-state",
    "allow-show-main-window",
    "allow-hide-companion-window",
    "allow-set-companion-expanded",
    "allow-analyze-quick-cleanup-command",
    "allow-run-quick-cleanup-command",
    "allow-cancel-quick-cleanup"
  ]
}
