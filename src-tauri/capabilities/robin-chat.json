{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "robin-chat",
  "description": "Conversation-only access for the bundled Robin chat window",
  "windows": [
    "robin-chat"
  ],
  "permissions": [
    "core:event:allow-listen",
    "allow-ai-get-state",
    "allow-ai-create-session",
    "allow-ai-list-sessions",
    "allow-ai-get-session",
    "allow-ai-set-session-context",
    "allow-ai-rename-session",
    "allow-ai-delete-session",
    "allow-ai-save-draft",
    "allow-ai-select-session-model",
    "allow-ai-prepare",
    "allow-ai-start",
    "allow-ai-cancel",
    "allow-ai-resolve-tool-confirmation",
    "core:event:allow-unlisten",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "allow-hide-ai-chat-window",
    "allow-ai-chat-continue-in-main",
    "allow-get-application-capability-state",
    "allow-ai-run-capability-action"
  ]
}
